        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (increase(stockpilot_domain_event_failures_total[10m]))",
          "legendFormat": "{{type}}",
          "refId": "A"

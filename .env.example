# Environnement local (docker compose). Copier en .env.

# Migrations et données de démonstration : rôle propriétaire des tables.
DATABASE_URL=postgresql://stockpilot:stockpilot@127.0.0.1:5437/stockpilot

# API et worker : rôle applicatif, soumis à la Row-Level Security.
APP_DATABASE_URL=postgresql://stockpilot_app:stockpilot_app@127.0.0.1:5437/stockpilot
REDIS_URL=redis://127.0.0.1:6380

PORT=3000
RESERVATION_TTL_SECONDS=900

# Jetons d'accès (32 caractères au moins) : en production, tiré de Secrets Manager.
JWT_SECRET=secret-local-de-developpement-a-remplacer-0123456789
# http en local : le cookie de session ne peut pas être « secure ».
COOKIE_SECURE=false
# Signature des notifications du prestataire de paiement (32 caractères au moins), partagée avec lui.
PAYMENT_WEBHOOK_SECRET=secret-local-du-prestataire-de-paiement-0123456789
# Worker : e-mails aux clients (Mailpit du docker compose ; sans SMTP_URL, ils sont seulement journalisés).
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Atelier Nova <commandes@atelier-nova.example>

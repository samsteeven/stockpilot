// Schéma StockPilot. Les règles que la base doit garantir seule (quantités, isolation entre entreprises,
// immuabilité des mouvements) sont dans les migrations SQL : contraintes CHECK, Row-Level Security, déclencheurs.
//
// Isolation : chaque table métier porte tenant_id, et les références entre tables passent par des clés
// composites (tenant_id, id) : une ligne ne peut pas pointer vers une ligne d'une autre entreprise.

generator client {
  provider     = "prisma-client"
  output       = "../libs/database/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantRole {
  OWNER
  ADMIN
  WAREHOUSE_MANAGER
  OPERATOR
  VIEWER
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  // Payé alors que la commande ne pouvait plus être honorée (réservation expirée) : à rembourser.
  REFUND_REQUIRED
}

enum ShipmentStatus {
  READY_TO_SHIP
  SHIPPED
  DELIVERED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum StockMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  warehouses   Warehouse[]
  products     Product[]
  reservations Reservation[]
  memberships  TenantMembership[]
  invitations  Invitation[]
  orders       Order[]
  shipments    Shipment[]

  @@map("tenants")
}

// Compte : global (une personne peut appartenir à plusieurs entreprises), pas une donnée d'entreprise.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Toujours en minuscules (normalisé par l'application).
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships   TenantMembership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Jeton de renouvellement : seule son empreinte est stockée. Une famille = une session ; un jeton rejoué
// (déjà échangé) révoque toute la famille.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model TenantMembership {
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      TenantRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

// Invitation à usage unique : seule l'empreinte du jeton est stockée, le lien n'est montré qu'une fois.
model Invitation {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  email      String
  role       TenantRole
  tokenHash  String     @unique @map("token_hash")
  invitedBy  String     @map("invited_by") @db.Uuid
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime?  @map("accepted_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("invitations")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  stocks    StockItem[]
  orders    Order[]
  shipments Shipment[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("warehouses")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sku       String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  variants ProductVariant[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, active])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  sku       String
  name      String
  // Prix unitaire en vigueur ; une commande en garde une copie (le prix peut changer ensuite).
  unitPrice Decimal @default(0) @map("unit_price") @db.Decimal(14, 2)
  currency  String  @default("EUR") @db.Char(3)

  product    Product     @relation(fields: [tenantId, productId], references: [tenantId, id])
  stocks     StockItem[]
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@map("product_variants")
}

model StockItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  version          Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  warehouse    Warehouse         @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  variant      ProductVariant    @relation(fields: [tenantId, variantId], references: [tenantId, id])
  reservations ReservationItem[]
  movements    StockMovement[]

  @@unique([tenantId, warehouseId, variantId])
  @@unique([tenantId, id])
  @@index([tenantId, variantId])
  @@map("stock_items")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  // Référence fournie par l'appelant (la commande) : la même référence ne réserve qu'une fois.
  reference   String
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  endedAt     DateTime?         @map("ended_at") @db.Timestamptz(3)

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  items  ReservationItem[]

  @@unique([tenantId, reference])
  @@unique([tenantId, id])
  @@index([status, expiresAt])
  @@map("reservations")
}

model ReservationItem {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  reservationId String @map("reservation_id") @db.Uuid
  stockItemId   String @map("stock_item_id") @db.Uuid
  quantity      Int

  reservation Reservation @relation(fields: [tenantId, reservationId], references: [tenantId, id])
  stockItem   StockItem   @relation(fields: [tenantId, stockItemId], references: [tenantId, id])

  @@unique([reservationId, stockItemId])
  @@map("reservation_items")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  stockItemId String            @map("stock_item_id") @db.Uuid
  type        StockMovementType
  // Signé : + entrée, - sortie. La somme des mouvements d'une ligne vaut son stock physique.
  quantity    Int
  referenceId String?           @map("reference_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  stockItem StockItem @relation(fields: [tenantId, stockItemId], references: [tenantId, id])

  @@index([tenantId, stockItemId, createdAt])
  @@map("stock_movements")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  warehouseId   String      @map("warehouse_id") @db.Uuid
  status        OrderStatus @default(PENDING_PAYMENT)
  currency      String      @db.Char(3)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(14, 2)
  customerEmail String?     @map("customer_email")
  reservationId String?     @map("reservation_id") @db.Uuid
  createdBy     String      @map("created_by") @db.Uuid
  // Pourquoi la commande a été annulée (paiement refusé, réservation expirée, annulation manuelle).
  cancelReason  String?     @map("cancel_reason")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  warehouse Warehouse            @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  items     OrderItem[]
  history   OrderStatusHistory[]
  payments  Payment[]
  shipment  Shipment?

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  variantId String  @map("variant_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)

  order   Order          @relation(fields: [tenantId, orderId], references: [tenantId, id])
  variant ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id])

  @@unique([orderId, variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String?
  // Absent quand le système agit seul (paiement reçu, réservation expirée).
  actorId    String?      @map("actor_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @db.Char(3)
  // Référence chez le prestataire, envoyée dans ses notifications.
  providerReference String        @unique @map("provider_reference")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt         DateTime?     @map("settled_at") @db.Timestamptz(3)

  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id])

  @@index([orderId])
  @@map("payments")
}

// Idempotency-Key : la réponse d'une création réussie est gardée et rejouée à l'identique pour la même clé.
model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  // Empreinte de la requête : la même clé avec une autre requête est refusée.
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, key])
  @@map("idempotency_keys")
}

// Outbox : l'événement est écrit dans la transaction du changement qu'il annonce, puis publié par le worker.
model OutboxEvent {
  id            String    @id @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  type          String
  payload       Json
  correlationId String?   @map("correlation_id")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([occurredAt])
  @@map("outbox_events")
}

// Messages déjà traités, par consommateur : un événement livré deux fois n'a d'effet qu'une fois.
model ProcessedMessage {
  consumer    String
  messageId   String   @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, messageId])
  @@map("processed_messages")
}

// Journal des actions sensibles : écrit dans la transaction de l'action, jamais modifié.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Une expédition par commande confirmée, créée par le worker à la confirmation.
model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  warehouseId    String         @map("warehouse_id") @db.Uuid
  status         ShipmentStatus @default(READY_TO_SHIP)
  carrier        String?
  trackingNumber String?        @map("tracking_number")
  shippedAt      DateTime?      @map("shipped_at") @db.Timestamptz(3)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  order     Order     @relation(fields: [tenantId, orderId], references: [tenantId, id])
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id])

  @@unique([tenantId, orderId])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("shipments")
}

// Message envoyé au client (e-mail). Une ligne par événement et par modèle : un événement relivré ne renvoie pas.
model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  template  String
  recipient String
  subject   String
  body      String
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?            @map("last_error")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime?          @map("sent_at") @db.Timestamptz(3)

  @@unique([eventId, template])
  @@index([tenantId, createdAt])
  @@map("notifications")
}
